# Next Thought — server-only configuration.
# Copy to .env.local and fill in the secret values. Never prefix any of these
# with NEXT_PUBLIC_: the browser must not be able to call the paid model directly.

# --- Azure OpenAI (v1 Responses API) ---
# The OpenAI SDK appends "responses" itself, so the base URL must end at /openai/v1/.
AZURE_OPENAI_BASE_URL=https://vedmtsfoundry.services.ai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
# Azure requires the *deployment* name here, which may differ from the catalogue model id.
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-terra
# Reading the page is parsing, so medium is measurably faster with no loss.
# Review and tutoring stay high: one guards correctness, the other is the teaching.
AZURE_OPENAI_EFFORT_ANALYSIS=medium
AZURE_OPENAI_EFFORT_REVIEW=high
AZURE_OPENAI_EFFORT_TUTOR=high
AZURE_OPENAI_MAX_OUTPUT_TOKENS=25000

# --- Azure AI Speech ---
AZURE_SPEECH_ENDPOINT=https://eastus.api.cognitive.microsoft.com/
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_RECOGNITION_LANGUAGE=en-IN
# Must list hi-IN as a secondary locale for Hinglish. Verify with the voices/list
# API before changing. Alternatives: en-IN-ArjunIndicNeural, en-IN-NeerjaIndicNeural.
AZURE_SPEECH_VOICE=en-IN-Arjun:DragonHDLatestNeural

# --- Household access protection ---
# Leave APP_ACCESS_CODE empty to disable the gate (e.g. when Vercel deployment
# protection is used instead). COOKIE_SIGNING_SECRET must be >= 32 chars when set.
APP_ACCESS_CODE=
COOKIE_SIGNING_SECRET=

# --- Local development conveniences ---
# "true" serves scripted sample tutoring without calling Azure (Phase 1 prototype mode).
NEXT_THOUGHT_USE_FIXTURES=false
